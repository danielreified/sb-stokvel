{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "@seyva/types": ["../../packages/types/src/index.ts"],
      "@seyva/validation": ["../../packages/validation/src/index.ts"],
      "@seyva/utils": ["../../packages/utils/src/index.ts"],
      "@seyva/api-client": ["../../packages/api-client/src/index.ts"],
      "@seyva/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/types/src",
    "../../packages/validation/src",
    "../../packages/utils/src",
    "../../packages/api-client/src",
    "../../packages/ui/src"
  ],
  // Test files are validated by running them, not by tsc --noEmit. They
  // import bun:test types we don't want polluting the production type-check
  // (bun-types' global fetch typing clashes with the DOM lib).
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "../../packages/**/__tests__/**",
    "../../packages/**/*.test.ts"
  ]
}
