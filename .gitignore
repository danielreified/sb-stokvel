# Lighthouse CI reports
.lighthouseci/

# Visual regression baselines: only Linux PNGs are canonical (generated from
# the Docker rig). Native runs on Mac/Windows produce host-suffixed PNGs we
# don't want in git.
tests/e2e/**/*-darwin.png
tests/e2e/**/*-win32.png

# vite-plugin-pwa dev SW output
dev-dist/
playwright/.auth/

# Terraform
**/.terraform/
**/.terraform-tmp/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan
crash.log
crash.*.log
# .tfvars hold secrets — committed examples are *.tfvars.example
*.tfvars
!*.tfvars.example
